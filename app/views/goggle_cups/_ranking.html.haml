-# Delegates to the shared engine ranking partial, supplying public route builders.
= render partial: 'goggles_db/goggle_cups/ranking',
         locals: { team: team, goggle_cup: goggle_cup, ranking_data: ranking_data,
                   no_duplicated_events: no_duplicated_events,
                   export_path: goggle_cup_export_lambda(goggle_cup),
                   swimmer_path: method(:swimmer_show_path_for_id),
                   meeting_path: method(:meeting_show_path_for_id),
                   base_timings_path: goggle_cup_base_timings_path(goggle_cup) }
